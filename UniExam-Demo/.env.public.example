# EC2 uniexam-public — WireGuard 10.200.0.1
# public-api là gateway: KHÔNG cần DATABASE_URL hay REDIS_URL.
# Sao chép thành .env rồi thay mọi giá trị <...>. Không commit file .env thật.
ENVIRONMENT=production
# Phải GIỐNG HỆT .env trên uniexam-private. Tạo bằng: openssl rand -hex 32 / openssl rand -hex 16
JWT_SECRET=<GIỐNG_UNIEXAM_PRIVATE_DÀI_ÍT_NHẤT_32_KÝ_TỰ>
INTERNAL_API_KEY=<GIỐNG_UNIEXAM_PRIVATE_ÍT_NHẤT_16_KÝ_TỰ>
CORS_ORIGINS=https://<PUBLIC_DOMAIN>
PUBLIC_API_PORT=4000
FRONTEND_PORT=8080
PRIVATE_API_URL=http://10.200.0.2:8080
WORKER_URL=http://10.200.0.2:8081
