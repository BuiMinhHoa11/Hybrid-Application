# EC2 uniexam-public — WireGuard 10.200.0.1
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://uniexam:<POSTGRES_PASSWORD>@10.200.0.2:5432/<POSTGRES_DB>
REDIS_URL=redis://10.200.0.2:6379/0
JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
INTERNAL_API_KEY=<RANDOM_INTERNAL_KEY_AT_LEAST_16_CHARACTERS>
JWT_LIFETIME_HOURS=8
CORS_ORIGINS=https://<PUBLIC_DOMAIN>
PUBLIC_API_PORT=4000
FRONTEND_PORT=8080
PRIVATE_API_URL=http://10.200.0.2:8080
WORKER_URL=http://10.200.0.2:8081
GRADING_POLL_SECONDS=2
LIFECYCLE_INTERVAL_SECONDS=5
LIFECYCLE_ENABLED=false
GRADING_QUEUE_NAME=uniexam:grading
GRADING_QUEUE_GROUP=grading-workers
