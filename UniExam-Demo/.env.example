# Application-host production configuration.
# Copy to .env on the application host and replace every <...> value.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://uniexam:<POSTGRES_PASSWORD>@<PRIVATE_DB_HOST>:5432/uniexam
REDIS_URL=redis://<PRIVATE_REDIS_HOST>:6379/0
JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
INTERNAL_API_KEY=<RANDOM_INTERNAL_KEY_AT_LEAST_16_CHARACTERS>
JWT_LIFETIME_HOURS=8
CORS_ORIGINS=https://<PUBLIC_DOMAIN>
PUBLIC_API_PORT=4100
PRIVATE_API_PORT=4101
WORKER_PORT=4102
FRONTEND_PORT=8081
GRADING_POLL_SECONDS=2
LIFECYCLE_INTERVAL_SECONDS=5
LIFECYCLE_ENABLED=true
GRADING_QUEUE_NAME=uniexam:grading
GRADING_QUEUE_GROUP=grading-workers
