{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission.graded",
  "title": "SubmissionGradedEvent",
  "type": "object",
  "required": ["type", "submissionId", "examId", "studentId", "score", "maxScore", "gradedAt"],
  "properties": {
    "type": { "const": "submission.graded" },
    "submissionId": { "type": "string", "format": "uuid" },
    "examId": { "type": "string", "format": "uuid" },
    "studentId": { "type": "string", "format": "uuid" },
    "score": { "type": "number", "minimum": 0 },
    "maxScore": { "type": "number", "exclusiveMinimum": 0 },
    "gradedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
