{
  "name": "uniexam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hệ thống thi trắc nghiệm trực tuyến UniExam",
  "workspaces": [
    "backend/contracts",
    "backend/node/packages/*",
    "database/node",
    "backend/node/services/*",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "migrate:node": "tsx database/node/scripts/migrate.ts",
    "seed:node": "tsx database/node/scripts/seed-demo.ts",
    "create-admin:node": "tsx backend/scripts/create-admin.ts",
    "dev:public-api": "uv run --project backend uvicorn uniexam.public_app:app --port 4100 --reload",
    "dev:private-api": "uv run --project backend uvicorn uniexam.exam_app:app --port 4101 --reload",
    "dev:grading-worker": "uv run --project backend uvicorn uniexam.worker:health_app --port 4102",
    "dev:node:public-api": "npm run dev -w @uniexam/public-api",
    "dev:node:private-api": "npm run dev -w @uniexam/private-api",
    "dev:node:grading-worker": "npm run dev -w @uniexam/grading-worker",
    "dev:frontend": "npm run dev -w @uniexam/frontend",
    "start": "node backend/scripts/run-local.mjs start",
    "stop": "node backend/scripts/run-local.mjs stop",
    "logs": "node backend/scripts/run-local.mjs logs",
    "status": "node backend/scripts/run-local.mjs status",
    "migrate": "node backend/scripts/run-local.mjs migrate",
    "seed": "node backend/scripts/run-local.mjs seed",
    "create-admin": "node backend/scripts/run-local.mjs create-admin",
    "change-password": "node backend/scripts/run-local.mjs change-password"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
