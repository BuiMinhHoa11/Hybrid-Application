# Instance uniexam-private — WireGuard 10.200.0.2
# Sao chép thành .env rồi thay mọi giá trị <...>. Không commit file .env thật.
# Host DB/Redis là tên container trong /srv/uniexam/compose.yml (cùng mạng Docker uniexam-internal).
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://uniexam:<POSTGRES_PASSWORD>@uniexam-postgres:5432/uniexam
REDIS_URL=redis://uniexam-redis:6379/0
# Phải GIỐNG HỆT .env trên uniexam-public. Tạo bằng: openssl rand -hex 32 / openssl rand -hex 16
JWT_SECRET=<RANDOM_SECRET_DÀI_ÍT_NHẤT_32_KÝ_TỰ>
INTERNAL_API_KEY=<RANDOM_KEY_ÍT_NHẤT_16_KÝ_TỰ>
JWT_LIFETIME_HOURS=8
CORS_ORIGINS=https://<PUBLIC_DOMAIN>
PUBLIC_API_URL=http://10.200.0.1:4000
PRIVATE_API_PORT=8080
WORKER_PORT=8081
FRONTEND_URL=http://10.200.0.1:8080
GRADING_POLL_SECONDS=2
LIFECYCLE_INTERVAL_SECONDS=5
LIFECYCLE_ENABLED=true
GRADING_QUEUE_NAME=uniexam:grading
GRADING_QUEUE_GROUP=grading-workers
# Email lịch thi: gửi cho sinh viên có email ngay khi kỳ thi được phát hành (hoặc vào giờ công bố).
# Amazon SES SMTP: SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com, SMTP_USER/PASSWORD = SMTP credentials của SES.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<gmail>, SMTP_PASSWORD=<mật khẩu ứng dụng 16 ký tự>.
# Kiểm tra: docker compose -f backend/compose.private.yaml exec private-api python -m uniexam.cli send-test-email <email>
EMAIL_ENABLED=false
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=UniExam <no-reply@<PUBLIC_DOMAIN>>
APP_PUBLIC_URL=https://<PUBLIC_DOMAIN>
# SES sandbox giới hạn 1 email/giây: để 1.1. Có production access (thường 14/giây) thì đặt 0.1.
EMAIL_SEND_INTERVAL_SECONDS=1.1
