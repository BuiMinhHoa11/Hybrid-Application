# Instance uniexam-private — WireGuard 10.200.0.2
# DB/Redis hostname phải là tên service trong /srv/uniexam/compose.yml nếu cùng Docker network;
# nếu không dùng chung network, thay bằng địa chỉ mà container truy cập được.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://uniexam:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:5432/<POSTGRES_DB>
REDIS_URL=redis://<REDIS_HOST>:6379/0
JWT_SECRET=<GIỐNG_SECRET_TRÊN_UNIEXAM_PUBLIC_DÀI_IT_NHẤT_32_KÝ_TỰ>
INTERNAL_API_KEY=<GIỐNG_INTERNAL_KEY_TRÊN_UNIEXAM_PUBLIC_IT_NHẤT_16_KÝ_TỰ>
JWT_LIFETIME_HOURS=8
CORS_ORIGINS=https://<PUBLIC_DOMAIN>
PUBLIC_API_URL=http://10.200.0.1:4000
PRIVATE_API_PORT=8080
WORKER_PORT=8081
FRONTEND_URL=http://10.200.0.1:8080
GRADING_POLL_SECONDS=2
LIFECYCLE_INTERVAL_SECONDS=5
LIFECYCLE_ENABLED=true
GRADING_QUEUE_NAME=uniexam:grading
GRADING_QUEUE_GROUP=grading-workers
